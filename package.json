{
  "name": "svgscript",
  "version": "0.9.0",
  "description": "Script SVG files",
  "license": "UNLICENSED",
  "homepage": "https://github.com/ad-si/svgscript",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ad-si/svgscript"
  },
  "main": "dist/server.js",
  "types": "dist/index.d.ts",
  "bin": {
    "svgscript": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "index.mustache"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup --config",
    "build:browser": "rollup --config",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "unit-tests": "NODE_OPTIONS=--experimental-vm-modules jest --silent",
    "test": "npm run typecheck && npm run unit-tests"
  },
  "keywords": [
    "svg"
  ],
  "author": "Adrian Sieber <mail@adriansieber.com>",
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [".ts"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext",
            "moduleResolution": "Bundler"
          }
        }
      ]
    },
    "testMatch": [
      "**/source/**/*.test.ts"
    ]
  },
  "dependencies": {
    "browserify": "^17.0.0",
    "browserify-middleware": "^8.1.1",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.2",
    "clean-css": "^5.2.2",
    "clone": "^2.1.2",
    "cssobj-core": "^1.1.9",
    "cssobj-plugin-gencss": "^2.0.7",
    "deg2rad": "^1.0.0",
    "express": "^4.17.2",
    "js-beautify": "^1.14.0",
    "js-yaml": "^4.1.0",
    "rad2deg": "^1.0.0",
    "rimraf": "^3.0.2",
    "sanctuary": "^3.1.0",
    "sanctuary-def": "^0.22.0",
    "semver": "^7.3.5",
    "shaven": "^2.1.0",
    "socket.io": "^4.4.0",
    "svgo": "2.8.0",
    "svgpath": "^2.3.1",
    "traverse": "^0.6.6"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^13.1.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/clean-css": "^4.2.11",
    "@types/clone": "^2.1.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-beautify": "^1.14.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.30",
    "@types/semver": "^7.5.8",
    "@types/traverse": "^0.6.37",
    "common-tags": "^1.8.2",
    "jest": "^29.7.0",
    "rollup": "^4.13.0",
    "tslib": "^2.6.2",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  }
}
